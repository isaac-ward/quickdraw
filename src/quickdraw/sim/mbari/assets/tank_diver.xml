<mujoco model="mbari_tank">
  <compiler angle="radian" meshdir="." texturedir="build"/>
  <!-- gravity 0: a trimmed AUV is neutrally buoyant. Damping lives in mola.py with the thrust. -->
  <option gravity="0 0 0" timestep="0.002" integrator="RK4" density="0" viscosity="0"/>
  <visual>
    <headlight ambient="0.58 0.60 0.62" diffuse="0.46 0.47 0.48" specular="0.06 0.06 0.06"/>
    <!-- shadows off, no multisampling: 141 -> 65 ms per 4-camera control step, and at 144x192
         under attenuating water a shadow is a handful of dim pixels. -->
    <quality shadowsize="512" offsamples="0"/>
  </visual>
  <asset>
    <texture name="t_yp" type="2d" file="wall_y+.png"/>
    <texture name="t_ym" type="2d" file="wall_y-.png"/>
    <texture name="t_xp" type="2d" file="wall_x+.png"/>
    <texture name="t_xm" type="2d" file="wall_x-.png"/>
    <texture name="t_fl" type="2d" file="floor.png"/>
    <material name="m_yp" texture="t_yp" texuniform="false" texrepeat="1 1" specular="0.1" shininess="0.1"/>
    <material name="m_ym" texture="t_ym" texuniform="false" texrepeat="1 1" specular="0.1" shininess="0.1"/>
    <material name="m_xp" texture="t_xp" texuniform="false" texrepeat="1 1" specular="0.1" shininess="0.1"/>
    <material name="m_xm" texture="t_xm" texuniform="false" texrepeat="1 1" specular="0.1" shininess="0.1"/>
    <material name="m_fl" texture="t_fl" texuniform="false" texrepeat="1 1" specular="0.05"/>
    <material name="m_surf" rgba="0.26 0.52 0.62 0.72" specular="0.9" shininess="0.9" reflectance="0.3"/>
    <material name="m_room" rgba="0.085 0.085 0.095 1" specular="0.02"/>
    <material name="m_lamp" rgba="1.0 0.92 0.45 1" emission="0.95" specular="0.1"/>
    <material name="m_gantry" rgba="0.93 0.74 0.05 1" specular="0.5" shininess="0.5"/>
    <material name="m_dock" rgba="0.72 0.74 0.78 1" specular="0.3"/>
    <material name="m_buoy_o" rgba="0.98 0.42 0.03 1" specular="0.6" shininess="0.6" emission="0.1"/>
    <material name="m_buoy_g" rgba="0.08 0.80 0.25 1" specular="0.6" shininess="0.6" emission="0.1"/>
    <material name="m_rope" rgba="0.85 0.85 0.80 1"/>
    <mesh name="mola0" file="mola/mola_g0.obj" scale="2.48 2.48 2.48"/><material name="mola_c0" rgba="0.612 0.427 0.027 1" specular="0.25" shininess="0.3"/><mesh name="mola1" file="mola/mola_g1.obj" scale="2.48 2.48 2.48"/><material name="mola_c1" rgba="0.0 0.0 0.0 1" specular="0.25" shininess="0.3"/><mesh name="mola2" file="mola/mola_g2.obj" scale="2.48 2.48 2.48"/><material name="mola_c2" rgba="0.698 0.494 0.043 1" specular="0.25" shininess="0.3"/><mesh name="mola3" file="mola/mola_g3.obj" scale="2.48 2.48 2.48"/><material name="mola_c3" rgba="0.718 0.51 0.047 1" specular="0.25" shininess="0.3"/><mesh name="mola4" file="mola/mola_g4.obj" scale="2.48 2.48 2.48"/><material name="mola_c4" rgba="0.341 0.757 0.8 1" specular="0.25" shininess="0.3"/><mesh name="mola5" file="mola/mola_g5.obj" scale="2.48 2.48 2.48"/><material name="mola_c5" rgba="0.4 0.4 0.4 1" specular="0.25" shininess="0.3"/><material name="m_diver" rgba="0.14 0.17 0.22 1" specular="0.4"/>
    <mesh name="dock" file="dock/dock_g0.obj" scale="1 1 1"/>
    <mesh name="diver" file="diver/diver_g0.obj" scale="1 1 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 5.5" dir="0 0 -1" diffuse="0.42 0.43 0.42" castshadow="false"/>
    <light pos="-4.5 0 -1.5" dir="0.3 0 -1" diffuse="0.26 0.28 0.28" castshadow="false"/>
    <light pos="4.5 0 -4.0" dir="-0.3 0 -0.6" diffuse="0.22 0.24 0.24" castshadow="false"/>

    <!-- THE TANK. Walls span the water column only: floor at -D up to z = 0, nothing above. -->
    <geom name="floor"  type="plane" material="m_fl" pos="0 0 -10.0" size="7.5 5.0 0.1"/>
    <geom name="wall_x+" type="plane" material="m_xp" pos="7.5 0 -5.0" size="5.0 5.0 0.1" euler="0 -1.5708 0"/>
    <geom name="wall_x-" type="plane" material="m_xm" pos="-7.5 0 -5.0" size="5.0 5.0 0.1" euler="0 1.5708 0"/>
    <geom name="wall_y+" type="plane" material="m_yp" pos="0 5.0 -5.0" size="7.5 5.0 0.1" euler="1.5708 0 0"/>
    <geom name="wall_y-" type="plane" material="m_ym" pos="0 -5.0 -5.0" size="7.5 5.0 0.1" euler="-1.5708 0 0"/>
    <geom name="surface" type="plane" material="m_surf" pos="0 0 -0.02" size="7.5 5.0 0.1" euler="3.14159 0 0"/>

    <!-- THE WAREHOUSE. A dark enclosed room around the tank, lit by ceiling lamps. The tank is a
         hole in its floor, so from underwater the surface reads as a lid with a lit room above. -->
    <geom name="room_ceil" type="plane" material="m_room" pos="0 0 6.0" size="13.5 11.0 0.1" euler="3.14159 0 0"/>
    <geom name="room_x+" type="plane" material="m_room" pos="13.5 0 3.0" size="4.0 11.0 0.1" euler="0 -1.5708 0"/>
    <geom name="room_x-" type="plane" material="m_room" pos="-13.5 0 3.0" size="4.0 11.0 0.1" euler="0 1.5708 0"/>
    <geom name="room_y+" type="plane" material="m_room" pos="0 11.0 3.0" size="13.5 4.0 0.1" euler="1.5708 0 0"/>
    <geom name="room_y-" type="plane" material="m_room" pos="0 -11.0 3.0" size="13.5 4.0 0.1" euler="-1.5708 0 0"/>
    <geom name="deck_x+" type="box" material="m_room" pos="10.5 0 -0.05" size="3 11.0 0.05"/>
    <geom name="deck_x-" type="box" material="m_room" pos="-10.5 0 -0.05" size="3 11.0 0.05"/>
    <geom name="deck_y+" type="box" material="m_room" pos="0 8.0 -0.05" size="7.5 3 0.05"/>
    <geom name="deck_y-" type="box" material="m_room" pos="0 -8.0 -0.05" size="7.5 3 0.05"/>
    <geom name="ceil_0" type="cylinder" material="m_lamp" size="0.45 0.04" pos="-5.2 -2.6 5.94" euler="0 0 0"/><light pos="-5.2 -2.6 5.8" dir="0 0 -1" diffuse="0.34 0.32 0.24" castshadow="false"/><geom name="ceil_1" type="cylinder" material="m_lamp" size="0.45 0.04" pos="-5.2 2.6 5.94" euler="0 0 0"/><light pos="-5.2 2.6 5.8" dir="0 0 -1" diffuse="0.34 0.32 0.24" castshadow="false"/><geom name="ceil_2" type="cylinder" material="m_lamp" size="0.45 0.04" pos="-1.7 -2.6 5.94" euler="0 0 0"/><light pos="-1.7 -2.6 5.8" dir="0 0 -1" diffuse="0.34 0.32 0.24" castshadow="false"/><geom name="ceil_3" type="cylinder" material="m_lamp" size="0.45 0.04" pos="-1.7 2.6 5.94" euler="0 0 0"/><light pos="-1.7 2.6 5.8" dir="0 0 -1" diffuse="0.34 0.32 0.24" castshadow="false"/><geom name="ceil_4" type="cylinder" material="m_lamp" size="0.45 0.04" pos="1.7 -2.6 5.94" euler="0 0 0"/><light pos="1.7 -2.6 5.8" dir="0 0 -1" diffuse="0.34 0.32 0.24" castshadow="false"/><geom name="ceil_5" type="cylinder" material="m_lamp" size="0.45 0.04" pos="1.7 2.6 5.94" euler="0 0 0"/><light pos="1.7 2.6 5.8" dir="0 0 -1" diffuse="0.34 0.32 0.24" castshadow="false"/><geom name="ceil_6" type="cylinder" material="m_lamp" size="0.45 0.04" pos="5.2 -2.6 5.94" euler="0 0 0"/><light pos="5.2 -2.6 5.8" dir="0 0 -1" diffuse="0.34 0.32 0.24" castshadow="false"/><geom name="ceil_7" type="cylinder" material="m_lamp" size="0.45 0.04" pos="5.2 2.6 5.94" euler="0 0 0"/><light pos="5.2 2.6 5.8" dir="0 0 -1" diffuse="0.34 0.32 0.24" castshadow="false"/>

    <!-- GANTRY: spans -X to +X at 1 m above the water, 2 m wide. The hook hangs from it to 1/4
         depth and is NEVER a target -- a fixed obstacle the model must learn is static. -->
    <body name="gantry" pos="0 0 1.0">
      <geom name="g_beam_a" type="box" material="m_gantry" pos="0 1.0 0" size="7.5 0.10 0.12"/>
      <geom name="g_beam_b" type="box" material="m_gantry" pos="0 -1.0 0" size="7.5 0.10 0.12"/>
      <geom name="g_cross_a" type="box" material="m_gantry" pos="-7.2 0 0" size="0.10 1.0 0.10"/>
      <geom name="g_cross_b" type="box" material="m_gantry" pos="0 0 0" size="0.10 1.0 0.10"/>
      <geom name="g_cross_c" type="box" material="m_gantry" pos="7.2 0 0" size="0.10 1.0 0.10"/>
      <geom name="g_leg_a" type="box" material="m_gantry" pos="-7.5 1.0 -0.55" size="0.12 0.12 0.55"/>
      <geom name="g_leg_b" type="box" material="m_gantry" pos="7.5 1.0 -0.55" size="0.12 0.12 0.55"/>
      <geom name="g_leg_c" type="box" material="m_gantry" pos="-7.5 -1.0 -0.55" size="0.12 0.12 0.55"/>
      <geom name="g_leg_d" type="box" material="m_gantry" pos="7.5 -1.0 -0.55" size="0.12 0.12 0.55"/>
    </body>
    <body name="hook" pos="1.2 0 0">
      <geom name="hook_line" type="capsule" material="m_gantry" fromto="0 0 1.0 0 0 -2.5" size="0.055"/>
      <geom name="hook_j" type="capsule" material="m_gantry" fromto="0 0 -2.5 0.42 0 -2.92" size="0.085"/>
      <geom name="hook_tip" type="sphere" material="m_gantry" pos="0.42 0 -3.05" size="0.12"/>
    </body>

    <body name="buoy_orange" pos="3.375 2.5 -5.0">
      <geom name="rope_o" type="capsule" material="m_rope" fromto="0 0 0 0 0 5.0" size="0.025"/>
      <geom name="buoy_o" type="sphere" material="m_buoy_o" size="0.38"/>
    </body>
    <body name="buoy_green" pos="-3.0 -2.25 -5.6">
      <geom name="rope_g" type="capsule" material="m_rope" fromto="0 0 0 0 0 5.6" size="0.025"/>
      <geom name="buoy_g" type="sphere" material="m_buoy_g" size="0.34"/>
    </body>

    <body name="dock" pos="-5.5 -3.0 -1.4" euler="0 0 0.7854">
      <geom name="dock_g" type="mesh" mesh="dock" material="m_dock" contype="0" conaffinity="0"/>
      <site name="dock_entry" pos="1.6 0 0.2" size="0.08" rgba="0 1 0 0"/>
    </body>

    <body name="mola" pos="0 0 -5">
      <freejoint name="mola_free"/>
      <geom name="mola_g0" type="mesh" mesh="mola0" material="mola_c0" mass="60" contype="0" conaffinity="0"/><geom name="mola_g1" type="mesh" mesh="mola1" material="mola_c1" mass="0.0001" contype="0" conaffinity="0"/><geom name="mola_g2" type="mesh" mesh="mola2" material="mola_c2" mass="0.0001" contype="0" conaffinity="0"/><geom name="mola_g3" type="mesh" mesh="mola3" material="mola_c3" mass="0.0001" contype="0" conaffinity="0"/><geom name="mola_g4" type="mesh" mesh="mola4" material="mola_c4" mass="0.0001" contype="0" conaffinity="0"/><geom name="mola_g5" type="mesh" mesh="mola5" material="mola_c5" mass="0.0001" contype="0" conaffinity="0"/>
      <camera name="fpv" pos="0.95 0 0.08" xyaxes="0 -1 0 0 0 1" fovy="70"/>
      <camera name="chase" pos="-5.4 0 1.9" xyaxes="0 -1 0 0.33 0 0.944" fovy="58"/>
      <site name="mola_c" pos="0 0 0" size="0.05" rgba="1 0 0 0"/>
    </body>
    
    <body name="diver" mocap="true" pos="0 0 -5" euler="0 1.3963 0">
      <geom name="diver_g" type="mesh" mesh="diver" material="m_diver" contype="0" conaffinity="0"/>
    </body>

    <camera name="topdown" pos="0 0 3.2" xyaxes="1 0 0 0 1 0" fovy="84" mode="fixed"/>
    <!-- SIDE-ON IS INSIDE THE TANK, against the -Y wall looking across. Outside the glass it was
         shooting through a textured wall plane and seeing mostly concrete. -->
    <camera name="sideon" pos="0 -4.4 -4.0" xyaxes="1 0 0 0 0.35 0.937" fovy="75" mode="fixed"/>
  </worldbody>
</mujoco>
